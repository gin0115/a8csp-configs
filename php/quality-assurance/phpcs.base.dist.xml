<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<!-- The rules phpcs.dist.xml and phpcs.tests.dist.xml share; each includes this file, so production and
	     test code cannot drift apart on house style or floors. Consumers reference those two profiles, not
	     this file. It deliberately carries no */tests/* exclusion: an included exclude-pattern applies to
	     every ruleset that includes it, and the tests profile would then scan nothing. -->

	<!-- What NOT to scan. -->
	<!-- PHPCS reads every exclude-pattern as a case-insensitive regex over the whole path: (?-i) keeps
	     PascalCase source folders such as src/Vendor/ in the scan, and literal dots are escaped. -->
	<exclude-pattern>(?-i)*/bin/*</exclude-pattern>
	<exclude-pattern>(?-i)*/vendor/*</exclude-pattern>
	<exclude-pattern>(?-i)*/node_modules/*</exclude-pattern>
	<exclude-pattern>(?-i)*/index\.php</exclude-pattern> <!-- This file is supposed to be empty. -->
	<exclude-pattern>(?-i)*/*\.asset\.php</exclude-pattern> <!-- This file is generated by the Gutenberg build process. -->
	<exclude-pattern>(?-i)*/blocks-manifest\.php</exclude-pattern> <!-- This file is generated by the @wordpress/scripts build-blocks-manifest step. -->
	<exclude-pattern>(?-i)*/languages/*\.l10n\.php</exclude-pattern> <!-- This file is generated by the internationalization process. -->
	<exclude-pattern>(?-i)*/dependencies/*</exclude-pattern> <!-- This folder is generated by the PHP scoping process. -->

	<!-- How to scan. -->
	<arg value="sp"/> <!-- Show sniff and progress. -->
	<arg name="colors"/> <!-- Show results with colors. Disable if working on Windows. -->
	<arg name="parallel" value="8"/> <!-- Enables parallel processing when available for faster results. -->
	<arg name="extensions" value="php"/> <!-- Only scan PHP files. -->

	<!-- Run against the PHPCompatibilityWP ruleset and check for cross-version PHP support. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.4-"/>

	<!-- Run against the WordPress-Extra ruleset and check for the minimum supported WP version. -->
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
		<!-- House style places `declare( strict_types=1 );` inline with the opening tag, before the file docblock. -->
		<exclude name="PSR12.Files.FileHeader.IncorrectOrder" />
		<!-- Short ternaries are house style. -->
		<exclude name="Universal.Operators.DisallowShortTernary" />
	</rule>
	<config name="minimum_wp_version" value="7.1"/>

	<!-- Allow additional word delimiters for hook names. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<properties>
			<property name="additionalWordDelimiters" value="/"/>
		</properties>
	</rule>

	<!-- Run against the WordPress-Docs ruleset and check for documentation standards. -->
	<rule ref="WordPress-Docs">
		<!-- Ignore missing file comment. -->
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<!-- Ignore end char rule since it conflicts with PhpStorm's code folding regions. -->
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar" />
		<!-- Exclude Block Editor pattern since they require special headers. -->
		<exclude-pattern>(?-i)*/patterns/*</exclude-pattern>
	</rule>

	<!-- Ignore missing tags if the docblock's first line is exactly {@inheritDoc}. -->
	<rule ref="Squiz.Commenting.FunctionComment">
		<properties>
			<property name="skipIfInheritdoc" value="true" />
		</properties>
		<!-- Allow generic type syntax (class-string<X>, list<X>) in docblocks over the erased native hint. -->
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
	</rule>

	<rule ref="Squiz.Commenting.FunctionCommentThrowTag.WrongNumber">
		<!-- Squiz miscounts @throws against implicit throws (e.g. `JSON_THROW_ON_ERROR`). -->
		<severity>0</severity>
	</rule>
</ruleset>
